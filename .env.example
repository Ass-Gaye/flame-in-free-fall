# Application environment reference.
#
# The backend reads backend/.env (copy backend/.env.example).
# The frontend reads frontend/.env.local (copy frontend/.env.example).
# This root file documents the complete set of variables in one place.

# --- Backend (Phase 2) ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5174,http://localhost:5173

# Prisma / SQLite. The database is generated from the dataset by the ingestion
# script and is never the source of truth. Paths resolve from backend/.
DATABASE_URL="file:./prisma/dev.db"

# Optional dataset override. Relative paths resolve from backend/.
# DATA_SOURCE_PATH="../nasa-fire-data/psi_output/merged_master_dataset.json"

# --- AI Provider (Phase 5) ---
# Supported providers: gemini (default with automatic ollama fallback), ollama
AI_PROVIDER=gemini

# Google Gemini Configuration (Primary Provider)
# Set a real key only in backend/.env, which is gitignored. Never commit one.
# If GEMINI_API_KEY is unset or unavailable, the system automatically falls back to Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (Fallback & Local Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b


# --- Frontend (Phase 1) ---
# Vite only exposes variables that start with VITE_
VITE_API_BASE_URL=http://localhost:3001/api
