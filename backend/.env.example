# Copy this file to backend/.env and adjust the values for your machine.
# backend/.env is ignored by Git.

DATABASE_URL="file:./prisma/dev.db"
PORT=3001
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
NODE_ENV=development

# Optional: override the dataset location. Relative paths resolve from backend/.
# DATA_SOURCE_PATH="../nasa-fire-data/psi_output/merged_master_dataset.json"

# AI Provider (gemini | ollama; defaults to gemini with automatic ollama fallback)
AI_PROVIDER=gemini

# Google Gemini Configuration (Primary Provider)
# Provide your Gemini API key; if unset, the backend automatically falls back to Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (Fallback & Local Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
